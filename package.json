{
	"name": "obsidian-header-backlinks",
	"version": "1.0.0",
	"description": "Header Backlinks — Obsidian plugin that shows anchor icons next to headings referenced by links (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"demo:screenshots": "npm run build && wdio run ./wdio.demo.conf.mjs --spec ./obsidian-tests/demo/readme-screenshots.e2e.mjs --spec ./obsidian-tests/demo/readme-screenshots-ru.e2e.mjs",
		"demo:screenshots:ru": "npm run build && wdio run ./wdio.demo.conf.mjs --spec ./obsidian-tests/demo/readme-screenshots-ru.e2e.mjs",
		"demo:capture": "npm run build && wdio run ./wdio.demo.conf.mjs --spec ./obsidian-tests/demo/demo.e2e.mjs --spec ./obsidian-tests/demo/demo-ru.e2e.mjs",
		"demo:render": "node ./obsidian-tests/demo/render-demo-gifs.mjs",
		"demo": "npm run build && wdio run ./wdio.demo.conf.mjs --spec ./obsidian-tests/demo/readme-screenshots.e2e.mjs --spec ./obsidian-tests/demo/readme-screenshots-ru.e2e.mjs --spec ./obsidian-tests/demo/demo.e2e.mjs --spec ./obsidian-tests/demo/demo-ru.e2e.mjs && npm run demo:render"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "^6.12.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.40.0",
		"@eslint/js": "9.30.1",
		"@eslint/json": "^1.2.0",
		"@types/node": "^16.11.6",
		"@wdio/cli": "^9.26.1",
		"@wdio/globals": "^9.26.1",
		"@wdio/local-runner": "^9.26.1",
		"@wdio/mocha-framework": "^9.26.1",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.2",
		"wdio-obsidian-reporter": "^2.4.0",
		"wdio-obsidian-service": "^2.4.0"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
